{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:8080/api/hooks",
            "headers": {
              "X-Hook-Token": "$AJAN_OFISI_TOKEN"
            },
            "allowedEnvVars": [
              "AJAN_OFISI_TOKEN"
            ],
            "timeout": 3
          }
        ]
      }
    ],
